<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="HospitalManagementSystem.Web.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Hospital Management System</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #eef3f8;
            color: #243447;
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(90deg, #0b3d5c 0%, #0d6efd 100%);
            color: white;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .navbar h1 {
            margin: 0;
            font-size: 24px;
        }

        .navbar-user {
            font-size: 13px;
            opacity: 0.95;
        }

        .menu {
            background: #ffffff;
            padding: 12px 30px;
            border-bottom: 1px solid #d9e4ef;
            display: flex;
            flex-wrap: wrap;
            gap: 8px 18px;
            align-items: center;
        }

        .menu a {
            text-decoration: none;
            color: #0b3d5c;
            font-weight: bold;
            padding: 4px 0;
        }

        .menu a:hover {
            color: #0d6efd;
        }

        .content {
            padding: 30px;
            max-width: 1200px;
            margin: 0 auto;
            min-height: calc(100vh - 180px);
            box-sizing: border-box;
        }

        .site-footer {
            background: #0b3d5c;
            color: #d7e6f3;
            text-align: center;
            padding: 16px 20px;
            font-size: 13px;
        }

        @media (max-width: 700px) {
            .navbar, .menu, .content {
                padding-left: 16px;
                padding-right: 16px;
            }

            .navbar {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

<form id="form1" runat="server">

    <div class="navbar">
        <h1>Hospital Management System</h1>
        <div class="navbar-user">
            <asp:Literal ID="litUserInfo" runat="server" />
        </div>
    </div>

    <div class="menu">
        <a href="~/Default.aspx" runat="server">Dashboard</a>
        <a href="~/Pages/Patients/List.aspx" runat="server">Patients</a>
        <a href="~/Pages/Doctors/List.aspx" runat="server">Doctors</a>
        <a href="~/Pages/Departments/List.aspx" runat="server">Departments</a>
        <a href="~/Pages/Appointments/List.aspx" runat="server">Appointments</a>
        <a href="~/Pages/MedicalRecords/List.aspx" runat="server">Medical Records</a>
        <a href="~/Pages/Prescriptions/List.aspx" runat="server">Prescriptions</a>
        <a href="~/Pages/Bills/List.aspx" runat="server">Bills</a>
        <a href="~/Reports.aspx" runat="server">Reports</a>
        <asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Login.aspx" Text="Login" />
        <asp:LinkButton ID="lnkLogout" runat="server" Text="Logout" OnClick="lnkLogout_Click" CausesValidation="false" />
    </div>

    <div class="content">

        <asp:ContentPlaceHolder
            ID="MainContent"
            runat="server">
        </asp:ContentPlaceHolder>

    </div>

    <div class="site-footer">
        Hospital Management System &mdash; Secure healthcare operations dashboard
    </div>

</form>

</body>
</html>
