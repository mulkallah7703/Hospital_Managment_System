<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="HospitalDb" connectionString="Data Source=YOUR_SQL_SERVER\SQLEXPRESS;Initial Catalog=malakallah13137;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- WebForms validators: classic client script (no jQuery ScriptResourceMapping required). -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- Replace SMTP placeholders on the server only. Do not commit real passwords. -->
    <add key="smtpHost" value="smtp.gmail.com" />
    <add key="smtpPort" value="587" />
    <add key="smtpUser" value="__SMTP_USER_HERE__" />
    <add key="smtpPassword" value="__SMTP_PASSWORD_HERE__" />
    <add key="smtpEnableSsl" value="true" />
    <add key="smtpFrom" value="__SMTP_FROM_HERE__" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <customErrors mode="RemoteOnly" />
    <httpRuntime targetFramework="4.8" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="60" slidingExpiration="true" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <pages validateRequest="true" controlRenderingCompatibilityVersion="4.0" clientIDMode="Predictable" />
  </system.web>
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Register.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
